      "source": [
        "scores = [85, 92, 78, 90, 65]\n",
        "print(\"First score:\", scores[0])\n",
        "print(\"Last score:\", scores[-1])\n",
        "print(\"First three:\", scores[0:3])\n",
        "scores.append(100)\n",
        "print(\"After adding:\", scores)\n",
        "for s in scores:\n",
        "    if s >= 90:\n",
        "        print(f\"{s} is an A grade\")"
      ]
    }
